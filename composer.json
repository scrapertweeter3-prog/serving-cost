  "type": "library",
  "license": "MIT",
  "homepage": "https://pastagi.com",
  "authors": [
    {
      "name": "James Verlander",
      "email": "scrapertweeter3@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "PoketDev\\ServingCost\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "PoketDev\\ServingCost\\Tests\\": "tests/"
    }
  },
  "support": {
    "source": "https://github.com/scrapertweeter3-prog/serving-cost"
  }
